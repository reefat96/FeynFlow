Cell[BoxData[
 RowBox[{
  RowBox[{"GetPropagator", "[", 
   RowBox[{"exp_", ",", "lorStructure_List", ",", "repRules_List"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"coefList", "=", 
       RowBox[{"{", "}"}]}], ",", 
      RowBox[{"expWithRep", "=", 
       RowBox[{"exp", "/.", "repRules"}]}], ",", 
      RowBox[{"listOfEqn", "=", 
       RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", "quadFormRep", ",", 
      "dabPbd", ",", "newLorStructure", ",", 
      RowBox[{"temResult", "=", 
       RowBox[{"{", "}"}]}], ",", "solution", ",", "\[IndentingNewLine]", 
      "rrDen"}], "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{
      "Create", " ", "a", " ", "list", " ", "of", " ", "coefficients", " ", 
       "a1"}], ",", "a2", ",", "...", ",", "an"}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "lorStructure", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"coefList", ",", 
          RowBox[{"\"\<a\>\"", "<>", 
           RowBox[{"ToString", "[", "i", "]"}]}]}], "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Creating", " ", "a", " ", "quadratic", " ", "form", " ", "with", " ", 
       "the", " ", "replacement", " ", "rules"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"quadFormRep", "=", 
      RowBox[{"Total", "[", 
       RowBox[{"coefList", "*", "lorStructure"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Dot", " ", "Product", " ", "between", " ", "given", " ", "expression", 
       " ", "and", " ", "the", " ", "quadFormRepl"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"dabPbd", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"quadFormRep", "/.", "repRules"}], ")"}], "*", "exp"}], "//",
            "DiracSimplify"}], "//", "Contract"}], ")"}], "/.", "repRules"}], 
       "//", "Simplify"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Change", " ", "of", " ", "the", " ", "given", " ", "Lorentz", " ", 
       "structure", " ", "to", " ", "match", " ", "the", " ", "lorentz", " ", 
       "indices"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"newLorStructure", "=", 
      RowBox[{"(", 
       RowBox[{"lorStructure", "/.", "repRules"}], ")"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Creating", " ", "a", " ", "List", " ", "of", " ", "Equations", " ", 
       "to", " ", "be", " ", "solved", " ", "later"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "lorStructure", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "1"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"listOfEqn", ",", " ", 
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{
              RowBox[{"FCI", "[", "dabPbd", "]"}], ",", 
              RowBox[{"FCI", "[", 
               RowBox[{"newLorStructure", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "==", "1"}]}],
           "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"listOfEqn", ",", " ", 
           RowBox[{
            RowBox[{"Coefficient", "[", 
             RowBox[{
              RowBox[{"FCI", "[", "dabPbd", "]"}], ",", 
              RowBox[{"FCI", "[", 
               RowBox[{"newLorStructure", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}], "==", "0"}]}],
           "]"}]}], "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Solving", " ", "for", " ", "the", " ", "coefficients", " ", "a1"}], 
       ",", " ", "a2", ",", " ", 
       RowBox[{"...", " ", "an"}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"solution", "=", 
      RowBox[{"Solve2", "[", 
       RowBox[{"listOfEqn", ",", "coefList"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Replacing", " ", "the", " ", "solutions", " ", "to", " ", "get", " ", 
       "the", " ", "inverse", " ", "of", "\[IndentingNewLine]", "the", " ", 
       "quadrartic", " ", 
       RowBox[{"form", "."}]}], "\[IndentingNewLine]", "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "solution", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{"AppendTo", "[", "\[IndentingNewLine]", 
        RowBox[{"temResult", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"solution", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "*", 
          RowBox[{"newLorStructure", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}],
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "We", " ", "do", " ", "not", " ", "want", " ", "any", " ", "Gamma", " ", 
       RowBox[{"Matrices", "/", " ", "Gamma"}], " ", "Slash", " ", "in", " ", 
       "the", " ", "denominator", "\[IndentingNewLine]", "so", " ", "we", " ",
        "have", " ", "to", " ", "introduce", " ", "the", " ", "following", 
       " ", "Denominator", " ", "Replacement"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"rrDen", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"(", 
         FractionBox["1", 
          RowBox[{"m_", " ", "-", " ", 
           RowBox[{"DiracGamma", "[", 
            RowBox[{"Momentum", "[", "k_", "]"}], "]"}]}]], ")"}], ":>", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", " ", "+", " ", 
           RowBox[{"DiracGamma", "[", 
            RowBox[{"Momentum", "[", "k", "]"}], "]"}]}], ")"}], "/", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Superscript", "[", 
            RowBox[{"m", ",", "2"}], "]"}], " ", "-", " ", 
           RowBox[{"Pair", "[", 
            RowBox[{
             RowBox[{"Momentum", "[", "k", "]"}], ",", " ", 
             RowBox[{"Momentum", "[", "k", "]"}]}], "]"}]}], ")"}]}]}], 
