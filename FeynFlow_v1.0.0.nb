       "Adding", " ", "all", " ", "the", " ", "replacement", " ", "rules", 
        " ", "for", " ", "the", " ", "fields"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"replacementRules", "=", 
        RowBox[{"{", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"QuantumField", "[", "field1_", "]"}], ":>", " ", 
           RowBox[{
            RowBox[{"QuantumField", "[", "field1", "]"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "/", "2"}], ")"}], "*", "\[Delta]", "*", 
             RowBox[{"SMPToSymbol", "[", 
              RowBox[{"Superscript", "[", 
               RowBox[{
                RowBox[{"Subscript", "[", 
                 RowBox[{"\[Delta]z", ",", "2"}], "]"}], ",", "field1"}], 
               "]"}], "]"}], "*", 
             RowBox[{"QuantumField", "[", "field1", "]"}]}]}]}], ",", 
          RowBox[{
           RowBox[{"QuantumField", "[", 
            RowBox[{"field1_", ",", 
             RowBox[{"{", "lor1_", "}"}]}], "]"}], ":>", " ", 
           RowBox[{
            RowBox[{"QuantumField", "[", 
