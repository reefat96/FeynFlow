      RowBox[{
      "The", " ", "following", " ", "is", " ", "used", " ", "to", " ", 
       "generate", " ", "the", " ", "text", " ", "file"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"fileName", "===", "Null"}], ",", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "expr", "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Writing \>\"", "<>", 
          RowBox[{"ToString", "[", "fileName", "]"}], "<>", 
          "\"\<file...\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"str", "=", 
         RowBox[{"OpenAppend", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Directory", "[", "]"}], ",", "fileName"}], "}"}], 
            "]"}], ",", 
           RowBox[{"PageWidth", "->", "Infinity"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Write", "[", 
         RowBox[{"str", ",", 
          RowBox[{
          "OutputForm", "[", 
           "\"\<AnalyticalCoupling[...]==G[...][...].\\n\>\"", "]"}], ",", 
          "expr"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Write", "[", 
         RowBox[{"str", ",", 
          RowBox[{"OutputForm", "[", "\"\<\\n \>\"", "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Close", "[", "str", "]"}]}]}], "\[IndentingNewLine]", "]"}], 
     ";"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
