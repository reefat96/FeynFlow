Cell[BoxData[
 RowBox[{
  RowBox[{"WriteGenProp", "[", 
   RowBox[{"expr_List", ",", "fileName_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", "str", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"str", "=", 
      RowBox[{"OpenWrite", "[", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Directory", "[", "]"}], ",", "fileName"}], "}"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Write", "[", 
      RowBox[{"str", ",", 
       RowBox[{"OutputForm", "[", "\"\<M$GenericPropagators = {\>\"", "]"}]}],
       "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<=", 
        RowBox[{"Length", "[", "expr", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Write", "[", 
         RowBox[{"str", ",", " ", 
          RowBox[{
          "OutputForm", "[", "\"\<AnalyticalPropagator[Internal][...]==\>\"", 
           "]"}]}], " ", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"i", "==", 
           RowBox[{"Length", "[", "expr", "]"}]}], ",", 
          RowBox[{"Write", "[", 
           RowBox[{"str", ",", 
            RowBox[{"expr", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Write", "[", 
           RowBox[{"str", ",", 
            RowBox[{"expr", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"OutputForm", "[", "\"\<, \\n \>\"", "]"}]}], "]"}]}], 
         "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Write", "[", 
      RowBox[{"str", ",", 
       RowBox[{"OutputForm", "[", "\"\<}\>\"", "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Close", "[", "str", "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
